#pragma once\
#include <string>\
#include "../include/BinaryRead.cxx"\
\
/*! ÊµÅÊÉµ∞ÊÉ≠ÆÁªÉ≥ÊÉæÉ§‰ΩÉ≥ */\
struct StreamInfo\
{\
    uint32_t sample_rate;\
    uint8_t bit_depth;\
    uint8_t channels;\
};\
\
/*! ÈÉø≥ÈÉÇÉ±ÊÉ™ΩË±ÉÅÁ±ª */\
class Audio\
{\
public:\
    Audio(std::string p);\
    virtual ~Audio() = 0;\
    void close();\
    std::string get_path();\
    virtual std::string get_encode() = 0 ;\
    virtual StreamInfo get_streaminfo() = 0;\
protected:\
    BinaryRead *audio_file;\
    std::string path;\
};\
\
/*! ÈÉø≥ÈÉÇÉ±Á±ªÊÉæÉ§ÈÄÉÄÔºÉ¨‰ºÉÄÂÉ••Ë∑ØÂæÉ§ */\
Audio::Audio(std::string p)\
{\
    path = p;\
    audio_file = new BinaryRead(path);\
}\
\
/*! ÈÉø≥ÈÉÇÉ±Á±ªÊÉæÉ∞ÊÉæÉ§ÔºÉ¨ÂÉ•≥ÈÉ∑≠ÊÉ∂Éß‰ª∂ÔºÉ¨ÈÉßÉ™ÊÉ¥æÊÉ¨ÉßÈÉ≤É® */\
Audio::~Audio()\
{\
    if (!audio_file->is_open()) {\
        audio_file->close();\
    }\
    if (!(audio_file == nullptr)) {\
        delete audio_file;\
        audio_file = nullptr;\
    }\
}\
\
/*! ÂÉ•≥ÈÉ∑≠ÈÉø≥ÈÉÇÉ±ÊÉ∂Éß‰ª∂ */\
void Audio::close()\
{\
    if (!audio_file->is_open()) {\
        audio_file->close();\
    }\
    if (!(audio_file == nullptr)) {\
        delete audio_file;\
        audio_file = nullptr;\
    }\
}\
\
/*! ËøÉ¥ÂÉªÉæÈÉø≥ÈÉÇÉ±Ë∑ØÂæÉ§ */\
std::string Audio::get_path()\
{\
    return path;\
}\
EOF
